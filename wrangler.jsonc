{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "game-suggestion-vote",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-16",

  "observability": {
    "enabled": true
  },

  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none"
  },

  "durable_objects": {
    "bindings": [
      {
        "name": "BOARD",
        "class_name": "Board"
      }
    ]
  },

  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["Board"]
    }
  ],

  "vars": {
    "SESSION_DAYS": "7",
    "PBKDF2_ITERATIONS": "100000",
    // AI 一键审核用的模型，换模型不用改代码。
    // 注意：glm-4.7-flash、qwen3 这类会把答案放进 tool_calls 的模型用不了（正文是 null）
    "AI_EMBED_MODEL": "@cf/baai/bge-m3",
    "AI_CHAT_MODEL": "@cf/meta/llama-3.3-70b-instruct-fp8-fast"
  },

  // Workers AI：后台「AI 一键审核」用（embedding 找相似 + 对话模型确认是否重复）
  "ai": {
    "binding": "AI"
  },

  "triggers": {
    "crons": ["0 3 * * *"]
  }
}
