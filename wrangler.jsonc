{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "game-suggestion-vote",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-16",

  "observability": {
    "enabled": true
  },

  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none"
  },

  "durable_objects": {
    "bindings": [
      {
        "name": "BOARD",
        "class_name": "Board"
      }
    ]
  },

  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["Board"]
    }
  ],

  "vars": {
    "SESSION_DAYS": "7",
    "PBKDF2_ITERATIONS": "100000",
    // AI 一键审核用的模型，换模型不用改代码。
    // 注意：glm-4.7-flash、qwen3 这类会把答案放进 tool_calls 的模型用不了（正文是 null）
    "AI_EMBED_MODEL": "@cf/baai/bge-m3",
    "AI_CHAT_MODEL": "@cf/meta/llama-3.3-70b-instruct-fp8-fast"
  },

  // Workers AI：后台「AI 一键审核」用（embedding 找相似 + 对话模型确认是否重复）
  "ai": {
    "binding": "AI"
  },

  // 自定义域名。写在这里，每次 deploy 都会保证它在；
  // 只在面板上加的话，删掉 Worker 就一起没了（踩过这个坑）。
  // 要加别的域名（比如 www）就往这个数组里加一条，再 deploy。
  "routes": [
    { "pattern": "xxidle.vip", "custom_domain": true }
  ],

  // 有 routes 时 wrangler 会默认关掉 workers.dev，这里显式打开：
  // 两个地址都通，自定义域名万一出问题还有个备用入口。
  // 不想保留就删掉这行（下次 deploy 起停用）。
  "workers_dev": true,

  "triggers": {
    "crons": ["0 3 * * *"]
  }
}
